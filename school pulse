# ---------------- DATABASE FUNCTIONS ----------------
def add_submission(teacher, student, class_name, problem, help_given, photo_bytes):
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute("""
        INSERT INTO submissions
        (teacher, student, class_name, problem, help_given, photo, created_at)
        VALUES (?, ?, ?, ?, ?, ?, ?)
    """, (
        teacher,
        student,
        class_name,
        problem,
        help_given,
        photo_bytes,
        datetime.now().strftime("%d-%m-%Y %I:%M %p")
    ))

    connection.commit()
    connection.close()


def get_teacher_submissions(teacher):
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute("""
        SELECT id, student, class_name, problem, help_given, photo,
               status, feedback, warning, coin_change, created_at
        FROM submissions
        WHERE teacher = ?
        ORDER BY id DESC
    """, (teacher,))

    submissions = cursor.fetchall()
    connection.close()

    return submissions


def get_pending_submissions():
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute("""
        SELECT id, teacher, student, class_name, problem, help_given,
               photo, created_at
        FROM submissions
        WHERE status = 'Pending'
        ORDER BY id DESC
    """)

    submissions = cursor.fetchall()
    connection.close()

    return submissions


def get_submission_by_id(submission_id):
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute("""
        SELECT id, teacher, student, class_name, problem, help_given,
               photo, status, feedback, warning, created_at
        FROM submissions
        WHERE id = ?
    """, (submission_id,))

    submission = cursor.fetchone()
    connection.close()

    return submission


def update_submission(
    submission_id,
    status,
    feedback,
    warning,
    coin_change
):
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute("""
        UPDATE submissions
        SET status = ?, feedback = ?, warning = ?, coin_change = ?
        WHERE id = ?
    """, (status, feedback, warning, coin_change, submission_id))

    connection.commit()
    connection.close()


def change_coins(teacher, amount):
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute("""
        UPDATE teacher_coins
        SET coins = coins + ?
        WHERE teacher = ?
    """, (amount, teacher))

    connection.commit()
    connection.close()


def get_teacher_coins(teacher):
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute("""
        SELECT coins FROM teacher_coins
        WHERE teacher = ?
    """, (teacher,))

    result = cursor.fetchone()
    connection.close()

    if result:
        return result[0]

    return 0


def get_leaderboard():
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute("""
        SELECT teacher, coins
        FROM teacher_coins
        ORDER BY coins DESC, teacher ASC
    """)

    rows = cursor.fetchall()
    connection.close()

    ranking_data = []

    for row in rows:
        ranking_data.append([row[0], row[1]])

    ranking = pd.DataFrame(ranking_data, columns=["Teacher", "Coins"])
    ranking.insert(0, "Rank", range(1, len(ranking) + 1))

    return ranking


def get_all_submissions_for_download():
