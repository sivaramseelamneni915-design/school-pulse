    cursor = connection.cursor()

    cursor.execute("""
        SELECT id, teacher, student, class_name, problem, help_given,
               status, feedback, warning, coin_change, created_at
        FROM submissions
        ORDER BY id DESC
    """)

    rows = cursor.fetchall()
    connection.close()

    download_data = []

    for row in rows:
        download_data.append({
            "Submission ID": row[0],
            "Teacher": row[1],
            "Student": row[2],
            "Class": row[3],
            "Problem": row[4],
            "Help Provided": row[5],
            "Status": row[6],
            "Feedback": row[7],
            "Warning": row[8],
            "Coins Changed": row[9],
            "Date and Time": row[10]
        })

    return pd.DataFrame(download_data)


def add_notification(teacher, message):
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute("""
        INSERT INTO notifications (teacher, message, created_at)
        VALUES (?, ?, ?)
    """, (
        teacher,
        message,
        datetime.now().strftime("%d-%m-%Y %I:%M %p")
    ))

    connection.commit()
    connection.close()


def get_notifications(teacher):
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute("""
        SELECT id, message, created_at, is_read
        FROM notifications
        WHERE teacher = ?
        ORDER BY id DESC
    """, (teacher,))

    notifications = cursor.fetchall()
    connection.close()

    return notifications


def mark_notifications_read(teacher):
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute("""
        UPDATE notifications
        SET is_read = 1
        WHERE teacher = ?
    """, (teacher,))

    connection.commit()
    connection.close()


def get_unread_notification_count(teacher):
    connection = get_connection()
    cursor = connection.cursor()

    cursor.execute("""
        SELECT COUNT(*)
        FROM notifications
        WHERE teacher = ? AND is_read = 0
    """, (teacher,))

    result = cursor.fetchone()
    connection.close()

    return result[0]


def review_submission(
    submission_id,
    status,
    feedback,
    warning,
    coin_change
):
    submission = get_submission_by_id(submission_id)

    if submission is None:
        st.error("Submission not found.")
        return

    teacher = submission[1]

    update_submission(
        submission_id,
        status,
        feedback,
        warning,
        coin_change
    )

    if coin_change != 0:
        change_coins(teacher, coin_change)

    if coin_change > 0:
        message = f"You received {coin_change} coin(s). Feedback: {feedback}"
    elif coin_change < 0:
        message = f"{coin_change} coin(s) were deducted. Feedback: {feedback}"
    else:
        message = f"Your submission was reviewed. Feedback: {feedback}"

    if warning:
        message = message + f" Warning: {warning}"

    add_notification(teacher, message)


